@model LibraryMvc.Models.Book
@{
    ViewData["Title"] = "Деталі книги";
}

<h2>@Model.Title</h2>
<hr />
<div class="card border-0 shadow-sm p-4 mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Автор</dt>
        <dd class="col-sm-9">@Model.Author</dd>
        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9"><code>@Model.ISBN</code></dd>
        <dt class="col-sm-3">Жанр</dt>
        <dd class="col-sm-9">@Model.Genre</dd>
        <dt class="col-sm-3">Рік видання</dt>
        <dd class="col-sm-9">@Model.PublicationYear</dd>
        <dt class="col-sm-3">Примірників</dt>
        <dd class="col-sm-9">Доступно @Model.AvailableCopies із @Model.TotalCopies</dd>
    </dl>
</div>

<h5>Історія видач цієї книги</h5>
<div class="card border-0 shadow-sm mb-3">
    <table class="table mb-0">
        <thead class="table-light">
            <tr>
                <th>Читач</th>
                <th>Дата видачі</th>
                <th>Повернути до</th>
                <th>Фактичне повернення</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Loans.Any())
            {
                <tr><td colspan="5" class="text-muted text-center py-3">Історія видач порожня</td></tr>
            }
            @foreach (var loan in Model.Loans.OrderByDescending(l => l.LoanDate))
            {
                <tr>
                    <td>@loan.Reader?.FullName</td>
                    <td>@loan.LoanDate.ToString("dd.MM.yyyy")</td>
                    <td>@loan.DueDate.ToString("dd.MM.yyyy")</td>
                    <td>@(loan.ReturnDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@loan.Status</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
<a asp-action="Index" class="btn btn-secondary">До каталогу</a>