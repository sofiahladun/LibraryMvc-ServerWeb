@model LibraryMvc.Models.Book
@{
    ViewData["Title"] = "Додати книгу";
}

<h2>Додати нову книгу</h2>
<hr />

@if (ViewBag.IsRestoredFromSession == true)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center" style="max-width: 700px;">
        <span>Відновлено незбережену чернетку з сесії.</span>
        <form asp-action="ClearCreateDraft" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-outline-dark">Очистити чернетку</button>
        </form>
    </div>
}

<div id="session-autosave-status" class="alert alert-light border small py-2 d-none" style="max-width: 700px;"></div>

<div class="card border-0 shadow-sm p-4" style="max-width: 700px;">
    <form asp-action="Create" method="post" data-draft-url="@Url.Action("SaveCreateDraft", "Books")">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
            <span asp-validation-for="Author" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ISBN" class="form-label"></label>
                <input asp-for="ISBN" class="form-control" placeholder="978-966-03-8211-4" />
                <span asp-validation-for="ISBN" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Genre" class="form-label"></label>
                <input asp-for="Genre" class="form-control" />
                <span asp-validation-for="Genre" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="PublicationYear" class="form-label"></label>
                <input asp-for="PublicationYear" class="form-control" type="number" />
                <span asp-validation-for="PublicationYear" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="TotalCopies" class="form-label"></label>
                <input asp-for="TotalCopies" class="form-control" type="number" />
                <span asp-validation-for="TotalCopies" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="AvailableCopies" class="form-label"></label>
                <input asp-for="AvailableCopies" class="form-control" type="number" />
                <span asp-validation-for="AvailableCopies" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-2">
            <button type="submit" name="actionType" value="db" class="btn btn-primary">Записати</button>
            <button type="submit" name="actionType" value="session" formnovalidate class="btn btn-outline-info">Зберегти сесію</button>
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/session-draft.js" asp-append-version="true"></script>
}