@model LibraryMvc.Models.Loan
@{
    ViewData["Title"] = "Редагувати видачу";
}

<h2>Редагувати запис видачі</h2>
<hr />

<div class="alert @(ViewBag.IsRestoredFromSession == true ? "alert-warning" : "alert-secondary") d-flex justify-content-between align-items-center" style="max-width: 700px;">
    <span>
        @if (ViewBag.IsRestoredFromSession == true)
        {
            <strong>Режим сесії:</strong> @:відображається чернетка з сесії. Зміни потраплять у БД лише після натискання «Записати в БД».
        }
        else
        {
            @:Запис видачі завантажено з БД у сесію для редагування.
        }
    </span>
    <form asp-action="ResetEditDraft" asp-route-id="@Model.Id" method="post" class="m-0 ms-2">
        <button type="submit" class="btn btn-sm btn-outline-dark text-nowrap">Скинути до версії з БД</button>
    </form>
</div>

<div id="session-autosave-status" class="alert alert-light border small py-2 d-none" style="max-width: 700px;"></div>

<div class="card border-0 shadow-sm p-4" style="max-width: 700px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-draft-url="@Url.Action("SaveEditDraft", "Loans", new { id = Model.Id })">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="BookId" class="form-label"></label>
            <select asp-for="BookId" asp-items="ViewBag.BookId" class="form-select"></select>
            <span asp-validation-for="BookId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ReaderId" class="form-label"></label>
            <select asp-for="ReaderId" asp-items="ViewBag.ReaderId" class="form-select"></select>
            <span asp-validation-for="ReaderId" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="LoanDate" class="form-label"></label>
                <input asp-for="LoanDate" class="form-control" type="date" />
                <span asp-validation-for="LoanDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" type="date" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="ReturnDate" class="form-label"></label>
                <input asp-for="ReturnDate" class="form-control" type="date" />
                <span asp-validation-for="ReturnDate" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                <option value="Видано">Видано</option>
                <option value="Повернуто">Повернуто</option>
            </select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Notes" class="text-danger small"></span>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-2">
            <button type="submit" name="actionType" value="db" class="btn btn-primary">Записати</button>
            <button type="submit" name="actionType" value="session" formnovalidate class="btn btn-outline-info">Зберегти сесію</button>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/session-draft.js" asp-append-version="true"></script>
}