@model LibraryMvc.Models.Loan
@{
    ViewData["Title"] = "Видалити запис видачі";
}

<h2 class="text-danger">Підтвердження видалення</h2>
<div class="alert alert-warning">
    Ви дійсно бажаєте видалити запис видачі книги <strong>@Model.Book?.Title</strong> читачу <strong>@Model.Reader?.FullName</strong>?
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>