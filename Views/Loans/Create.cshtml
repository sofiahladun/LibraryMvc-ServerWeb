@model LibraryMvc.Models.Loan
@{
    ViewData["Title"] = "Видати книгу";
}

<h2>Оформлення видачі книги</h2>
<hr />
<div class="card border-0 shadow-sm p-4" style="max-width: 650px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="BookId" class="form-label"></label>
            <select asp-for="BookId" asp-items="ViewBag.BookId" class="form-select" required>
                <option value="">-- Оберіть книгу --</option>
            </select>
            <span asp-validation-for="BookId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ReaderId" class="form-label"></label>
            <select asp-for="ReaderId" asp-items="ViewBag.ReaderId" class="form-select" required>
                <option value="">-- Оберіть читача --</option>
            </select>
            <span asp-validation-for="ReaderId" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="LoanDate" class="form-label"></label>
                <input asp-for="LoanDate" class="form-control" type="date" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" type="date" required />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Видати книгу</button>
            <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
        </div>
    </form>
</div>