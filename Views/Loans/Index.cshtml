@model IEnumerable<LibraryMvc.Models.Loan>
@{
    ViewData["Title"] = "Видачі та повернення";
    var currentFilter = ViewData["StatusFilter"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Журнал видачі та повернення книг</h2>
    <a asp-action="Create" class="btn btn-primary">+ Оформити видачу</a>
</div>

<div class="btn-group mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary @(string.IsNullOrEmpty(currentFilter) ? "active" : "")">Усі</a>
    <a asp-action="Index" asp-route-statusFilter="active" class="btn btn-outline-secondary @(currentFilter == "active" ? "active" : "")">На руках</a>
    <a asp-action="Index" asp-route-statusFilter="overdue" class="btn btn-outline-danger @(currentFilter == "overdue" ? "active" : "")">Протерміновані</a>
    <a asp-action="Index" asp-route-statusFilter="returned" class="btn btn-outline-success @(currentFilter == "returned" ? "active" : "")">Повернуті</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Книга</th>
                    <th>Читач</th>
                    <th>Дата видачі</th>
                    <th>Повернути до</th>
                    <th>Повернуто</th>
                    <th>Статус</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isOverdue = item.Status == "Видано" && item.DueDate < DateTime.Today;
                    <tr>
                        <td class="fw-semibold">@item.Book?.Title</td>
                        <td>@item.Reader?.FullName</td>
                        <td>@item.LoanDate.ToString("dd.MM.yyyy")</td>
                        <td>@item.DueDate.ToString("dd.MM.yyyy")</td>
                        <td>@(item.ReturnDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>
                            @if (item.Status == "Повернуто")
                            {
                                <span class="badge bg-success">Повернуто</span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge bg-danger">Протерміновано</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Видано</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (item.Status == "Видано")
                            {
                                <form asp-action="ReturnBook" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Повернути</button>
                                </form>
                            }
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>