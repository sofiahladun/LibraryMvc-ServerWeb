@model LibraryMvc.Models.Reader
@{
    ViewData["Title"] = "Редагувати читача";
}

<h2>Редагувати дані читача</h2>
<hr />

<div class="alert @(ViewBag.IsRestoredFromSession == true ? "alert-warning" : "alert-secondary") d-flex justify-content-between align-items-center" style="max-width: 700px;">
    <span>
        @if (ViewBag.IsRestoredFromSession == true)
        {
            <strong>Режим сесії:</strong> @:відображається чернетка з сесії. Зміни потраплять у БД лише після натискання «Записати в БД».
        }
        else
        {
            @:Дані читача завантажено з БД у сесію для редагування.
        }
    </span>
    <form asp-action="ResetEditDraft" asp-route-id="@Model.Id" method="post" class="m-0 ms-2">
        <button type="submit" class="btn btn-sm btn-outline-dark text-nowrap">Скинути до версії з БД</button>
    </form>
</div>

<div id="session-autosave-status" class="alert alert-light border small py-2 d-none" style="max-width: 700px;"></div>

<div class="card border-0 shadow-sm p-4" style="max-width: 700px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-draft-url="@Url.Action("SaveEditDraft", "Readers", new { id = Model.Id })">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="LibraryCardNumber" class="form-label"></label>
                <input asp-for="LibraryCardNumber" class="form-control" />
                <span asp-validation-for="LibraryCardNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="RegistrationDate" class="form-label"></label>
                <input asp-for="RegistrationDate" class="form-control" type="date" />
                <span asp-validation-for="RegistrationDate" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="mt-3 d-flex flex-wrap gap-2">
            <button type="submit" name="actionType" value="db" class="btn btn-primary">Записати</button>
            <button type="submit" name="actionType" value="session" formnovalidate class="btn btn-outline-info">Зберегти сесію</button>
            <a asp-action="Index" class="btn btn-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/session-draft.js" asp-append-version="true"></script>
}