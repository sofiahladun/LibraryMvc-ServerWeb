@model LibraryMvc.Models.Reader
@{
    ViewData["Title"] = "Видалити читача";
}

<h2 class="text-danger">Підтвердження видалення</h2>
<div class="alert alert-warning">Ви дійсно бажаєте видалити читача <strong>@Model.FullName</strong> (@Model.LibraryCardNumber)?</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Видалити</button>
    <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
</form>