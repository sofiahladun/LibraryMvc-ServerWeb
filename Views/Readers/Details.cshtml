@model LibraryMvc.Models.Reader
@{
    ViewData["Title"] = "Картка читача";
}

<h2>@Model.FullName</h2>
<hr />
<div class="card border-0 shadow-sm p-4 mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Читацький квиток</dt>
        <dd class="col-sm-9"><code>@Model.LibraryCardNumber</code></dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Телефон</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>
        <dt class="col-sm-3">Дата реєстрації</dt>
        <dd class="col-sm-9">@Model.RegistrationDate.ToString("dd.MM.yyyy")</dd>
        <dt class="col-sm-3">Адреса</dt>
        <dd class="col-sm-9">@Model.Address</dd>
    </dl>
</div>

<h5>Взяті книги</h5>
<div class="card border-0 shadow-sm mb-3">
    <table class="table mb-0">
        <thead class="table-light">
            <tr>
                <th>Книга</th>
                <th>Дата видачі</th>
                <th>Повернути до</th>
                <th>Повернуто</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Loans.Any())
            {
                <tr><td colspan="5" class="text-muted text-center py-3">Читач ще не брав книг</td></tr>
            }
            @foreach (var loan in Model.Loans.OrderByDescending(l => l.LoanDate))
            {
                <tr>
                    <td>@loan.Book?.Title</td>
                    <td>@loan.LoanDate.ToString("dd.MM.yyyy")</td>
                    <td>@loan.DueDate.ToString("dd.MM.yyyy")</td>
                    <td>@(loan.ReturnDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@loan.Status</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редагувати</a>
<a asp-action="Index" class="btn btn-secondary">До списку читачів</a>